# =============================================
# Snake Game – Bale Mini App Configuration
# =============================================
# Copy this file to .env and fill in your values.

# Your Bale bot token (get it from @BotFather on Bale)
BOT_TOKEN=

# Public HTTPS URL where the game is hosted (no trailing slash)
# This URL is used as the web_app URL in the bot's inline keyboard.
# Example: https://yourdomain.com  or  https://yourapp.railway.app
MINIAPP_URL=

# Port the Express server will listen on (default: 3000)
PORT=3000

# Optional: path to the SQLite database file (default: scores.db)
# DB_PATH=scores.db
